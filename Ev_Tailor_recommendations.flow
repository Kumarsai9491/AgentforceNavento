    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>details like ev car and its price</description>
        <name>stores_the_records</name>
        <label>stores the records</label>
        <locationX>527</locationX>
        <locationY>830</locationY>
        <assignmentItems>
            <assignToReference>Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ev_recommendations.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>price</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ev_recommendations.Price__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>range</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ev_recommendations.Total_Range__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>shortdecription</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ev_recommendations.Detail_Description__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Get the EV recommendation of the user specific</description>
    <environments>Default</environments>
    <formulas>
        <name>DateF</name>
        <dataType>Date</dataType>
        <expression>Today()+7</expression>
    </formulas>
    <interviewLabel>Ev Tailor recommendations {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Ev Tailor recommendations</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
