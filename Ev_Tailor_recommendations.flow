        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Opportunity</name>
        <label>Create Opportunity</label>
        <locationX>527</locationX>
        <locationY>506</locationY>
        <connector>
            <targetReference>Slack2025Flow</targetReference>
        </connector>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>DateF</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>contact_records.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>NameOpp</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Qualification</stringValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>contact_records</name>
        <label>contact records</label>
        <locationX>527</locationX>
        <locationY>182</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>vehicle_details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LastName</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Navento</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>ev_recommendations</name>
        <label>ev recommendations</label>
        <locationX>527</locationX>
        <locationY>398</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Opportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Total_Range__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>vehicle_details.Max_KM_driven_in_a_Day__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>EV_cars__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>store the vehicle details</description>
        <name>vehicle_details</name>
        <label>vehicle details</label>
        <locationX>527</locationX>
        <locationY>290</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>ev_recommendations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>contact_records.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vehicle_Detail__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>401</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>contact_records</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>Message</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&gt; *Gear up, Sales Team! 🚗*
&gt; *A new opportunity has just landed — the existing customer is interested in a vehicle. Time to rev up and close the deal! *
&gt; *Name:* {!contact_records.Name} ({!contact_records.Phone})
&gt; *Current Vehicle Name:* {!vehicle_details.Name}
&gt; *Interested Vehicle Name:* {!ev_recommendations.Name}
&lt;https://orgfarm-f568774866.lightning.force.com/lightning/r/Opportunity/{!Create_Opportunity}/view|View Record in salesforce&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>NameOpp</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
