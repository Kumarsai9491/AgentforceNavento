<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>adds_the_score_for_half_clutch_and_brake</name>
        <label>adds the score for half clutch and brake</label>
        <locationX>534</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>overallscoreforbraking</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>10.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_all_driving_details</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>brake</name>
        <label>brake</label>
        <locationX>578</locationX>
        <locationY>1058</locationY>
        <assignmentItems>
            <assignToReference>repairancost</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Due to frequent hard braking , expect brake pad replacement costing ₹10,000. usually these parts would be changing at 40,000 kilometer, but your car is driven only {!get_vehicle_details.Total_driven_kms__c} might need to change at 35,000 kilometer</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>clutch</name>
        <label>clutch</label>
        <locationX>314</locationX>
        <locationY>1058</locationY>
        <assignmentItems>
            <assignToReference>repairancost</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Due to frequent half clutch, expect clutch pads costing ₹10,000. usually these parts would be changing at 40,000 kilometer, but your car is driven only {!get_vehicle_details.Total_driven_kms__c} might need to change at 35,000 kilometer</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>count_of_half_clutch</name>
        <label>count of half clutch</label>
        <locationX>1062</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>countforhalfclutch</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>5.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_all_driving_details</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>count_of_hard_brake</name>
        <label>count of hard brake</label>
        <locationX>798</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>countforhardbrake</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>5.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_all_driving_details</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>get the exact parts to be get repaired soon</description>
        <name>value_asignment</name>
        <label>exact part</label>
        <locationX>50</locationX>
        <locationY>1058</locationY>
        <assignmentItems>
            <assignToReference>repairancost</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Due to frequent hard braking and half clutch, expect brake pad replacement,clutch pads costing ₹20,000. usually these parts would be changing at 40,000 kilometer, but your car is driven only {!get_vehicle_details.Total_driven_kms__c} might need to change at 35,000 kilometer</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>checks_the_braking_and_clutch_frequency</name>
        <label>checks the braking and clutch frequency</label>
        <locationX>930</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>get_all_driving_details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>checks_clutch_and_braking</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_all_driving_details.Hard_Braking_Frequency__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_all_driving_details.Half_clutch_frequency__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>adds_the_score_for_half_clutch_and_brake</targetReference>
            </connector>
            <label>checks clutch and braking</label>
        </rules>
        <rules>
            <name>only_hard_braking</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_all_driving_details.Hard_Braking_Frequency__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>count_of_hard_brake</targetReference>
            </connector>
            <label>only hard braking</label>
        </rules>
        <rules>
            <name>only_half_clutch</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_all_driving_details.Half_clutch_frequency__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>count_of_half_clutch</targetReference>
            </connector>
            <label>only half clutch</label>
        </rules>
    </decisions>
    <decisions>
        <name>checks_the_overall_score</name>
        <label>checks the overall score</label>
        <locationX>446</locationX>
        <locationY>950</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>for_combination</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>overallscoreforbraking</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>value_asignment</targetReference>
            </connector>
            <label>for combination</label>
        </rules>
        <rules>
            <name>for_clutch</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>countforhalfclutch</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>clutch</targetReference>
            </connector>
            <label>for clutch</label>
        </rules>
        <rules>
            <name>for_brake</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>countforhardbrake</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>brake</targetReference>
            </connector>
            <label>for brake</label>
        </rules>
    </decisions>
    <description>Gets the exact parts and its respective cost</description>
    <environments>Default</environments>
    <interviewLabel>get the repair cost and parts {!$Flow.CurrentDateTime}</interviewLabel>
    <label>get the repair cost and parts</label>
    <loops>
        <name>get_all_driving_details</name>
        <label>get all driving details</label>
        <locationX>446</locationX>
        <locationY>458</locationY>
        <collectionReference>get_driving_logs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>checks_the_braking_and_clutch_frequency</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>checks_the_overall_score</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>get_contacts</name>
        <label>get contacts</label>
        <locationX>446</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>get_vehicle_details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LastName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Navento</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>get_driving_logs</name>
        <label>get driving logs</label>
        <locationX>446</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>get_all_driving_details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Vehicle_Detail__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>get_vehicle_details.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Driving_Logs__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>get_vehicle_details</name>
        <label>get vehicle details</label>
        <locationX>446</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>get_driving_logs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>get_contacts.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vehicle_Detail__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>320</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>get_contacts</targetReference>
        </connector>
    </start>
