<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>assign_left_side_count</name>
        <label>assign left side count</label>
        <locationX>402</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>CountOnLeftSide</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>get_Driving_records.Sensor_count__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>riskscore</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>5.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_Driving_records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_right_side_count</name>
        <label>Assign right side count</label>
        <locationX>666</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>CountOnRightSide</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>get_Driving_records.Sensor_count__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>riskscore</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>5.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_Driving_records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_3</name>
        <label>Assignment 3</label>
        <locationX>50</locationX>
        <locationY>1058</locationY>
        <assignmentItems>
            <assignToReference>Strorethecountofrightside</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>finaloutcome</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assignment_4</name>
        <label>Assignment 4</label>
        <locationX>314</locationX>
        <locationY>1058</locationY>
        <assignmentItems>
            <assignToReference>storesthecountonleftside</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>finaloutcomeleftside</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>checks_the_sensor_counts</name>
        <label>checks the sensor counts</label>
        <locationX>314</locationX>
        <locationY>950</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>From_right_side</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CountOnRightSide</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>40.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_3</targetReference>
            </connector>
            <label>From right side</label>
        </rules>
        <rules>
            <name>left_side</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CountOnLeftSide</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>40.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_4</targetReference>
            </connector>
            <label>left side</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_1</name>
        <label>Sensor count</label>
        <locationX>666</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>get_Driving_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Sensor_count_from_left_side</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_Driving_records.Sensor_Detection_Area__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>leftvalue</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_Driving_records.Sensor_count__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>10.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assign_left_side_count</targetReference>
            </connector>
            <label>Sensor count from left side</label>
        </rules>
        <rules>
            <name>Sensor_count_from_right_side</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_Driving_records.Sensor_Detection_Area__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>rightside</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_Driving_records.Sensor_count__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>10.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_right_side_count</targetReference>
            </connector>
            <label>Sensor count from right side</label>
        </rules>
    </decisions>
    <description>Get the suggestions areas and improvement area</description>
    <environments>Default</environments>
    <formulas>
        <name>last30days</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} -30</expression>
    </formulas>
    <interviewLabel>Driving Score And recommendation area {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Driving Score And recommendation area</label>
    <loops>
        <description>get all driving records for last 30 days.</description>
        <name>get_Driving_records</name>
        <label>get Driving records</label>
        <locationX>314</locationX>
        <locationY>458</locationY>
        <collectionReference>Driving_Logs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_1</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>checks_the_sensor_counts</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>get the driving logs related to last 30 days</description>
        <name>Driving_Logs</name>
        <label>Driving Logs</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>get_Driving_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>last30days</elementReference>
            </value>
        </filters>
        <filters>
            <field>Vehicle_Detail__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Vehicle_records.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Driving_Logs__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_contacts</name>
        <label>Get contacts</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Vehicle_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LastName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Navento</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>get the vehicle detail</description>
        <name>Vehicle_records</name>
        <label>Vehicle records</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Driving_Logs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_contacts.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vehicle_Detail__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_contacts</targetReference>
        </connector>
    </start>
    <status>Active</status>
