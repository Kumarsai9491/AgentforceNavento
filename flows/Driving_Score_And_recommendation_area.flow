        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Your Driving risk score is {!riskscore}/100 ,right side lane departure sensors activated more often. Focus on the left side area.</stringValue>
        </value>
    </variables>
    <variables>
        <name>finaloutcomeleftside</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Your Driving risk score is {!riskscore}/100 ,left side lane departure sensors activated more often. Focus on the left side area.</stringValue>
